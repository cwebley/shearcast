# OpenRouter key for the typesafe/jev-1.13 decision model.
OPENROUTER_API_KEY=

# Cloudflare R2 (S3-compatible object storage). Account-scoped values, not
# per-channel settings, so they live here rather than in config.toml. See the
# R2 dashboard: bucket Settings tab for the account id and public URL,
# "Manage R2 API tokens" for the access key pair.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
